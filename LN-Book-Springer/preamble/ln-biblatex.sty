%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% -- Makros für biblatex
%% -- Rom-BibLaTeX.sty
%% -- Stand: 2025-11-12
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}	%
\ProvidesPackage{./preamble/ln-biblatex}
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage[%
  	,style 			= numeric	
   	,sorting		= nyt
	,hyperref		= true  
	,maxcitenames  	= 2 	% viele Autoren -> nur die ersten beiden erscheinen  
	,mincitenames  	= 1		% Muss sein
    ,maxbibnames   	= 10	% im Verzeichnis tauchen alle auf
   	,giveninits		= true	% Vornamen als Initiale Ulrich -> U.
	,backend		= biber % wichtig
 	,uniquename		= false
 	,refsection=chapter
]{biblatex}  	
%%
\ExecuteBibliographyOptions{%
 	,url		= true		% true: URL werden angezeigt
 	,doi		= true%false		% DOI werden im Titel hinterlegt 
	,eprint		= false		% werden in der bib entfernt
	}
%% --
%% --
\AtEveryBibitem{\clearfield{issn}}%
\AtEveryBibitem{\clearlist{language}}%
\AtEveryBibitem{\clearlist{location}}%
\AtEveryBibitem{\clearfield{pagetotal}}%
%%\AtEveryBibitem{\clearfield{month}}%
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Kein Komma nach Verlag bei Büchern
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\renewbibmacro*{publisher+location+date}{%
  \printlist{publisher}%
  \setunit*{\addspace}%
%  \printlist{location}%
%  \setunit*{\addsemicolon\space}%
  \usebibmacro{date}%
  \newunit%
	} % ende makro
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Ausgabe Journal-Band(Nummer)-Jahr-Seiten
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%	
\renewbibmacro*{journal+issuetitle}{% 
  \usebibmacro{journal}% 
  \setunit*{\addspace}% 
  \iffieldundef{series} 
    {} 
    {\newunit 
     \printfield{series}% 
     \setunit{\addspace}}% 
  \printfield{volume}% 
  \iffieldundef{number} 
     {} 
      {\kern1pt\mkbibparens{\printfield{number}}}% \addspace
  \setunit{\addcomma\space}% 
  \printfield{eid}% 
  \setunit{\addspace}% 
  \usebibmacro{issue+date}% 
  \setunit{\addcolon\space}% 
  \usebibmacro{issue}% 
  \newunit}
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Felder bei Typ -- article --
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareFieldFormat[article]{number}{#1} 
\DeclareFieldFormat[article]{volume}{\textbf{#1}} 
\DeclareFieldFormat[article]{pages}{#1}
\DeclareFieldFormat[article]{title}{\mkbibemph{#1}}
\DeclareFieldFormat{journaltitle}{#1}
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Felder bei Typ -- book --
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareFieldFormat[book]{title}{\mkbibemph{#1}}
\DeclareFieldFormat[book]{date}{\mkbibparens{#1}}
\DeclareFieldFormat[book]{pages}{} 
\DeclareFieldFormat[book]{pagetotal}{} 
\DeclareFieldFormat[book]{url}{} 
\DeclareFieldFormat[book]{language}{}
\DeclareFieldFormat[book]{isbn}{} 
\DeclareFieldFormat[book]{series}{} 
\DeclareFieldFormat[book]{number}{} 
\DeclareFieldFormat[book]{volume}{}% kein „Vol.“ bei Büchern (21.10.2026)
\DeclareFieldFormat[book]{edition}{} 
\DeclareFieldFormat[book]{address}{} 
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Felder bei Typ -- manual --
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareFieldFormat[manual]{title}{\mkbibemph{#1}\addspace}
\DeclareFieldFormat[manual]{date}{\mkbibparens{#1}}
\DeclareFieldFormat[manual]{version}{}
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Felder bei Typ -- online --
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareFieldFormat[online]{date}{\mkbibparens{#1}}
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Beiträge, Berichte, Hochschulschriften (21.10.2026):
%% einheitlich zu article/book: Titel kursiv, Jahr in Klammern,
%% kein „Vol.“, kein „pp.“, kein Komma vor dem Jahr
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareFieldFormat[incollection,inproceedings,inbook,report,thesis,unpublished,misc]{title}{\mkbibemph{#1}}
\DeclareFieldFormat[incollection,inproceedings,inbook]{booktitle}{#1}
\DeclareFieldFormat[incollection,inproceedings,inbook,report,thesis,unpublished,misc]{date}{\mkbibparens{#1}}
\DeclareFieldFormat[incollection,inproceedings,inbook,report,thesis,unpublished,misc]{volume}{#1}
\DeclareFieldFormat[incollection,inproceedings,inbook,report,thesis,unpublished,misc]{pages}{#1}
\renewbibmacro*{institution+location+date}{%
  \printlist{institution}%
  \setunit*{\addspace}%
  \usebibmacro{date}%
  \newunit}
\renewbibmacro*{organization+location+date}{%
  \printlist{organization}%
  \setunit*{\addspace}%
  \usebibmacro{date}%
  \newunit}
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DeclareFieldFormat{postnote}{#1}
\DeclareFieldFormat{multipostnote}{#1}
%%%
\renewcommand*{\labelnamepunct}{\addcolon\space}%
\renewcommand*{\finalnamedelim}{\addspace\&\addspace}% 	
\renewcommand*{\bibpagespunct}{\addspace} %\addcomma
%%\renewcommand*{\newunitpunct}{\addspace}
\renewcommand*{\finentrypunct}{}% kein Punkt am Ende eines Eintrags (21.10.2026)
\renewcommand{\mkbibnamegiven}{\textsc}
\renewcommand{\mkbibnamefamily}{\textsc}
%%%
\renewcommand*{\intitlepunct}{}
\renewbibmacro{in:}{}

%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% URL 
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\DefineBibliographyStrings{german}{%
	andothers = {et al. },
	and     = {u\adddot},
  	urlseen = {aufgerufen am },
  	urlfrom = {URL },
	}
\DeclareFieldFormat{url}{\bibstring{urlfrom}\addcolon\space\url{#1}}
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% URL auf neuer Zeile
%% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newbibmacro*{bbx:parunit}{%
  \ifbibliography
    {\setunit{\bibpagerefpunct}\newblock
     \usebibmacro{pageref}%
     \clearlist{pageref}%
     \setunit{\addperiod\par\nobreak}}
    {}}

\renewbibmacro*{doi+eprint+url}{%
  \usebibmacro{bbx:parunit}% Added
  \iftoggle{bbx:doi}
    {\printfield{doi}}
    {}%
  \iftoggle{bbx:eprint}
    {\usebibmacro{eprint}}
    {}%
  \iftoggle{bbx:url}
    {\usebibmacro{url+urldate}}
    {}}
  
\renewbibmacro*{eprint}{%
  \usebibmacro{bbx:parunit}% Added
  \iffieldundef{eprinttype}
    {\printfield{eprint}}
    {\printfield[eprint:\strfield{eprinttype}]{eprint}}}
